# kanshi - dynamic monitor profiles for Hyprland
# https://wiki.archlinux.org/title/Kanshi
#
# kanshi watches for connected outputs and applies the FIRST matching profile.
# A profile matches when ALL outputs it lists are connected, so keep the most
# specific profiles (most monitors) at the TOP.
#
# Outputs are matched by CONNECTOR NAME (DP-1, DP-6, eDP-1) to stay consistent
# with ~/.config/hypr/hyprland/monitor-vars.conf, which defines the logical
# monitors used for workspace placement:
#
#   $monitor1 = DP-1    (left   - Dell 4K   3840x2160)  -> workspaces 1-8
#   $monitor2 = DP-6    (middle - Dell 1080p 1920x1080)  -> workspaces 9-16
#   $monitor3 = eDP-1   (internal laptop    1920x1200)  -> workspaces 17-20
#
# kanshi only sets the PHYSICAL layout (mode/position/scale). The
# workspace<->monitor binding lives in workspaces.conf and is applied by
# Hyprland automatically once these outputs are brought up here, so
# monitor1/2/3 keep the same meaning across every profile.
#
# Workflow:
#   nwg-displays mode (default):
#     - Arrange monitors with nwg-displays; Hyprland reads monitors.conf directly.
#   kanshi mode:
#     - Run enable-kanshi to capture current layout as a profile and take over.
#     - Run disable-kanshi to revert to nwg-displays / monitors.conf mode.

# --- Full dock: 4K (left) + 1080p (middle) + internal (right) ---
profile docked_full {
    output DP-1  mode 3840x2160@60Hz position 0,0    scale 2.0
    output DP-6  mode 1920x1080@60Hz position 1920,0 scale 1.0
    output eDP-1 mode 1920x1200@60Hz position 3840,0 scale 1.0
}

# --- Dock, lid closed: external Dells only ---
profile docked_external {
    output DP-1 mode 3840x2160@60Hz position 0,0    scale 2.0
    output DP-6 mode 1920x1080@60Hz position 1920,0 scale 1.0
}

# --- Undocked: laptop panel only ---
profile laptop {
    output eDP-1 mode 1920x1200@60Hz position 0,0 scale 1.0
}
