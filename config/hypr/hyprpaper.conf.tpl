# hyprpaper.conf.tpl
# Template for hyprpaper.conf — generated at login by apply-monitor-vars.sh.
# Edit monitor connector names in monitor-vars.conf, not here.
# The generated hyprpaper.conf is gitignored.

wallpaper {
    monitor = {{MONITOR1}}
    path = {{WALLPAPER}}
    fit_mode = cover
}

wallpaper {
    monitor = {{MONITOR2}}
    path = {{WALLPAPER}}
    fit_mode = cover
}

wallpaper {
    monitor = {{MONITOR3}}
    path = {{WALLPAPER}}
    fit_mode = cover
}

splash = false
